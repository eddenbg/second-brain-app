# PostgreSQL Configuration for Docker Compose
# Copy this to .env and fill in your own values before deploying

# PostgreSQL Superuser password (used for initial setup)
POSTGRES_SUPERUSER_PASSWORD=your_secure_superuser_password_here

# Application database name
APP_DB_NAME=second_brain_app

# Application database user
APP_DB_USER=second_brain_app_user

# Application database user password
# IMPORTANT: Use a strong, randomly generated password in production
# Example: openssl rand -base64 32
APP_DB_PASSWORD=your_secure_app_password_here

# PostgreSQL host and port (internal Docker network)
# From the app backend perspective, use: postgres:5432
# From host machine (for debugging): 127.0.0.1:5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional: PostgreSQL connection pool settings (for application backend)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Optional: Enable PostgreSQL slow query logging (ms threshold)
# Default: no logging
LOG_MIN_DURATION_STATEMENT=1000
